# ============================================
# WH40k Colony Manager - Frontend Environment
# ============================================
# 
# Copy this file to .env.local for development
# or .env.production for production builds
#
# ============================================
# API CONFIGURATION
# ============================================

# Backend API base URL
# Development: http://localhost:8000
# Production: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8000

# ============================================
# BUILD CONFIGURATION
# ============================================

# Application title (displayed in browser tab)
VITE_APP_TITLE=WH40k Colony Manager

# Application version (optional - can be set by CI/CD)
# VITE_APP_VERSION=1.0.0

# ============================================
# FEATURE FLAGS (Optional)
# ============================================

# Enable debug mode (shows additional UI elements)
# VITE_DEBUG_MODE=false

# Enable mock API (for offline development)
# VITE_USE_MOCK_API=false

# ============================================
# ANALYTICS (Optional)
# ============================================

# Analytics/tracking ID (if using external analytics)
# VITE_ANALYTICS_ID=

# ============================================
# NOTES
# ============================================
#
# Development:
#   1. Copy this file to .env.local
#   2. Set VITE_API_BASE_URL=http://localhost:8000
#   3. Run: npm run dev
#
# Production:
#   1. Copy this file to .env.production
#   2. Set VITE_API_BASE_URL=https://api.yourdomain.com
#   3. Run: npm run build
#
# Environment Variable Precedence:
#   .env.production > .env.local > .env > default values
#
# ============================================