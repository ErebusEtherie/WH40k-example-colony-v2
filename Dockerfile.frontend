# WH40k Colony Manager - Frontend Production Dockerfile
# Multi-stage build: Node.js build environment -> NGINX Alpine runtime

# ============================================
# Stage 1: Build Environment
# ============================================
FROM node:22-alpine AS builder

WORKDIR /app

# Set production environment for build tooling
ENV NODE_ENV=production

# Install build dependencies if needed
RUN apk add --no-cache libc6-compat

# Copy dependency manifests
COPY package.json package-lock.json ./

# Install npm dependencies using ci for reproducible builds (including devDependencies required for Vite build)
RUN npm ci --include=dev --ignore-scripts

# Copy configuration and source files
COPY tsconfig.json vite.config.ts index.html metadata.json* ./
COPY src/ ./src/
COPY public/ ./public/

# Optional build argument to customize API base URL if not using standard reverse proxy
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# Compile TypeScript and bundle frontend with Vite
RUN npx vite build

# ============================================
# Stage 2: Runtime Environment (NGINX)
# ============================================
FROM nginx:1.31.5-alpine-slim AS runtime

# Install curl for health checks
RUN apk add --no-cache curl

# Remove default Nginx welcome page and configs
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf

# Copy custom Nginx configuration tailored for React SPA and API proxying
COPY nginx/frontend.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Ensure proper permissions for the nginx user
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

# Expose standard container port
EXPOSE 80

# Container healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/health || exit 1

# Start Nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
